REDIS_HOSTS=stringkey,stringkey
REDIS_PORTS=integerkey,integerkey
REDIS_DBS=integerkey,integerkey
REDIS_PASSWORDS=stringkey,stringkey
# Optional instance names, aligned with REDIS_HOSTS (default: the host).
# Required when the same host appears more than once (e.g. monitoring several
# DBs of one Redis); names become the metric `instance` label and the
# instance prefix in MONITOR_QUEUES / MONITOR_STREAMS.
REDIS_NAMES=stringkey,stringkey

# Format: instance;queue (queues) and instance;stream:group (streams)
MONITOR_QUEUES=stringkey;stringkey,stringkey;stringkey
MONITOR_STREAMS=stringkey;stringkey:stringkey

LISTEN_ADDR=:9808
